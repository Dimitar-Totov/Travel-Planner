# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Unsplash (https://unsplash.com/oauth/applications) — "Access Key" of an
# Unsplash API application. Optional: `/plan`'s hero photo falls back to a
# static image when this is unset.
UNSPLASH_ACCESS_KEY=

# MongoDB Atlas connection string
MONGODB_URI=

# Auth.js (next-auth@beta / v5) — required.
# Generate with: npx auth secret
# (writes AUTH_SECRET to .env.local for you; or run `openssl rand -base64 33`
# and paste the value in yourself)
AUTH_SECRET=

# Auth.js (next-auth@beta / v5) — only needed in production if you're NOT on
# Vercel (Vercel infers this from request headers automatically) or if your
# app is served from a URL Auth.js can't otherwise detect, e.g. behind a
# proxy/CDN that rewrites the Host header. Not required for local dev.
# AUTH_URL=https://your-production-domain.example

# Cloudflare R2 (https://dash.cloudflare.com — R2 > Manage API Tokens, create
# an API token scoped to the bucket below). R2_ACCOUNT_ID is the hex account
# id shown on the R2 overview page (also the subdomain of the S3 endpoint,
# `<account id>.r2.cloudflarestorage.com`). Optional today — `src/lib/storage/r2.ts`
# builds the client and presigned upload URLs, but nothing in the app calls it
# yet — required once guide-image uploads move off in-memory data URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for serving R2 objects — the bucket's managed public
# subdomain (R2 > bucket > Settings > Public access > Allow Access, which
# mints a URL shaped like https://pub-<hash>.r2.dev). r2.dev is rate-limited
# and documented by Cloudflare as development-only, but it's what's used
# here since a custom domain isn't available. Swap in a custom domain later
# by changing just this var — nothing else keys off r2.dev specifically.
# `next.config.ts` reads this var's hostname at config-load time to build
# `images.remotePatterns`, so changing it needs a restart/rebuild, not just
# a new request.
R2_PUBLIC_BASE_URL=
S3_API_ENDPOINT=
