# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# MongoDB Atlas connection string
MONGODB_URI=

# Auth.js (next-auth@beta / v5) — required.
# Generate with: npx auth secret
# (writes AUTH_SECRET to .env.local for you; or run `openssl rand -base64 33`
# and paste the value in yourself)
AUTH_SECRET=

# Auth.js (next-auth@beta / v5) — only needed in production if you're NOT on
# Vercel (Vercel infers this from request headers automatically) or if your
# app is served from a URL Auth.js can't otherwise detect, e.g. behind a
# proxy/CDN that rewrites the Host header. Not required for local dev.
# AUTH_URL=https://your-production-domain.example
